with "config/mspm0c1104_config.gpr";
project Mspm0c1104 is

	for Source_Dirs use ("src/", "config/");
	for Object_Dir use "obj/" & Mspm0c1104_Config.Build_Profile;
	for Create_Missing_Dirs use "True";
	for Exec_Dir use "bin";
	for Main use ("mspm0c1104.adb");
	for Target use "arm-elf";
	for Runtime ("Ada") use "light-cortex-m0p";

	package Compiler is
	  for Default_Switches ("Ada") use Mspm0c1104_Config.Ada_Compiler_Switches;
	end Compiler;

	package Binder is
	  for Switches ("Ada") use ("-Es"); --  Symbolic traceback
	end Binder;

	package Install is
	  for Artifacts (".") use ("share");
	end Install;

	package Linker is
		--  Linker script generated by startup-gen
		for Switches ("Ada") use ("-T", Project'Project_Dir & "/src/link.ld");
	end Linker;

	package Device_Configuration is

		--  Name of the CPU core on the LP-MSPM0C1104
		for CPU_Name use "ARM Cortex-M0+";

		for Float_Handling use "soft";

		--  Number of interrupt lines on the LP-MSPM0C1104
		for Number_Of_Interrupts use "32";

		--  List of memory banks on the LP-MSPM0C1104
		for Memories use ("SRAM", "FLASH");

		--  Specify from which memory bank the program will load
		for Boot_Memory use "FLASH";

		--  Allocate the main stack in SRAM with 512 byte size
		for Main_Stack_Memory use "SRAM";
		for Main_Stack_Size use "512";

		--  Specification of the SRAM
		for Mem_Kind ("SRAM") use "ram";
		for Address ("SRAM") use "0x20000000";
		for Size ("SRAM") use "1K";

		--  Specification of the FLASH
		for Mem_Kind ("FLASH") use "rom";
		for Address ("FLASH") use "0x00000000";
		for Size ("FLASH") use "16K";

	end Device_Configuration;

end Mspm0c1104;
